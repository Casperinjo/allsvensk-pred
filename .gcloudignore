# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# IMPORTANT: without this file, gcloud falls back to .gitignore — which excludes
# data/raw/SWE.csv and models/, breaking the image build (the Dockerfile COPYs the
# CSV, and train.py needs it). This file keeps data/ in the upload.
#
# Mirrors .dockerignore: exclude dev-only and regenerated files, keep the CSV.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
tests
notebooks
models
*.md
.env
.DS_Store
requirements-dev.txt
