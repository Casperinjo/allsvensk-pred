# Keep the build context small and the image clean. We COPY only what we need in
# the Dockerfile, but excluding these also speeds up the build and avoids leaks.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
tests
notebooks
models          # regenerated inside the image by train.py
*.md
.env
.DS_Store
requirements-dev.txt
